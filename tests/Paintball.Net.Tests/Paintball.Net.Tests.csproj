<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests für Server-Simulation, Lobby, Protokoll und WSS-Integration (QA-01, QA-02).
    Abhängigkeitsfreier Testlauf wie Paintball.Core.Tests.
    Ausführen: dotnet run (Projekt tests/Paintball.Net.Tests)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Paintball.Net.Tests</AssemblyName>
    <RootNamespace>Paintball.Net.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\server\Paintball.Server\Paintball.Server.csproj" />
    <Compile Include="**\*.cs" Exclude="bin\**;obj\**" />
  </ItemGroup>

</Project>
