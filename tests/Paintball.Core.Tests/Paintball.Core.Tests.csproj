<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Konsolen-Testlauf für die engine-unabhängige Kernlogik (QA-01).
    Kompiliert dieselben Quelldateien wie die Unity-Assembly "Paintball.Core",
    damit die Tests ohne Unity-Editor überall laufen (CI, NFR-18).
    Ausführen: dotnet run -p tests/Paintball.Core.Tests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Paintball.Core.Tests</AssemblyName>
    <RootNamespace>Paintball.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Scripts\Core\**\*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
